# Copy to .env (or export in your shell) for anything beyond local dev.
# .env is gitignored.

# Flask session signing key — REQUIRED for production, any long random string
SECRET_KEY=change-me-to-a-long-random-string

# SQLite path (dev default is backend/stationary.db via relative URI).
# For production point this at an absolute path or swap in a real DB:
# DATABASE_URL=sqlite:////absolute/path/stationary.db

# Which config class to boot (default | development | production)
# FLASK_CONFIG=development