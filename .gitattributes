# ── Default: normalise line endings to LF in repo, checkout as-is ───────────
* text=auto eol=lf

# ── Explicitly text ──────────────────────────────────────────────────────────
*.js        text eol=lf
*.jsx       text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.env*      text eol=lf

# ── Explicitly binary (never diff/merge) ─────────────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.xlsx      binary
*.xls       binary
*.db        binary
*.sqlite    binary
